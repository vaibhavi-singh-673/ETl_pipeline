digraph RetailMart {
rankdir=LR; graph [splines=ortho, nodesep=.55, ranksep=1.0];
node [shape=record, fontname="Arial", fontsize=10];
categories [label="{categories|PK category_id|category_name|description}"];
products [label="{products|PK product_id|FK category_id|product_name|unit_price|cost_price|stock_quantity|is_active}"];
customers [label="{customers|PK customer_id|first_name|last_name|email|phone|city|registration_date|loyalty_tier}"];
sales_transactions [label="{sales_transactions|PK transaction_id|FK customer_id|store_id|transaction_date|transaction_time|payment_method|total_amount|discount_amount|tax_amount|net_amount}"];
sales_items [label="{sales_items|PK item_id|FK transaction_id|FK product_id|quantity|unit_price|line_total}"];
vouchers [label="{vouchers|PK voucher_id|voucher_code|voucher_type|discount_value|min_purchase_amount|max_discount_amount|valid_from|valid_to|is_active}"];
voucher_redemptions [label="{voucher_redemptions|PK redemption_id|FK voucher_id|FK transaction_id|FK customer_id|redemption_date|discount_applied}"];
returns [label="{returns|PK return_id|FK transaction_id|FK item_id|FK customer_id|FK product_id|return_date|return_quantity|return_reason|refund_amount|refund_status}"];
categories -> products; customers -> sales_transactions; sales_transactions -> sales_items; products -> sales_items;
vouchers -> voucher_redemptions; customers -> voucher_redemptions; sales_transactions -> voucher_redemptions;
sales_transactions -> returns; sales_items -> returns; customers -> returns; products -> returns;
}